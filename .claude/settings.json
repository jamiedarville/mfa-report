{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pwsh ./execution/latest-mfa-report.ps1:*)",
      "Bash(pwsh -c Get-Module -ListAvailable Microsoft.Graph.Authentication)",
      "Bash(cat execution/README.md)",
      "Read(./execution/**)",
      "Read(./.claude/**)",
      "Write(./.tmp/**)",
      "Edit(./execution/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./credentials.json)",
      "Read(./token.json)",
      "Read(./output/**)",
      "Bash(rm -rf:*)"
    ]
  }
}
